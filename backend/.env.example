# Copy to .env (never commit real secrets).
APP_NAME=Intern API
ENVIRONMENT=development

# Postgres in Docker for local dev. Later: point at Neon (just change this URL).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/intern

# Groq key for the AI advisor (B3). The API boots fine while this is empty.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
